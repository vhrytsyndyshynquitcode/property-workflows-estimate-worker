{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill(estimate-checker)",
      "Agent(estimate-verifier)",
      "Bash(node scripts/check-estimate.mjs *)",
      "PowerShell(node scripts/check-estimate.mjs *)",
      "Read(/data/**)",
      "Read(/references/**)",
      "Read(/out/**)",
      "Edit(/out/**)",
      "Write(/out/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Edit(/data/**)",
      "Edit(/scripts/**)",
      "Edit(/references/**)",
      "Edit(/.claude/**)",
      "Edit(/.github/**)",
      "Edit(/AGENTS.md)",
      "Edit(/CLAUDE.md)",
      "Write(/data/**)",
      "Write(/scripts/**)",
      "Write(/references/**)",
      "Write(/.claude/**)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)",
      "Bash(git *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git *)"
    ]
  }
}
